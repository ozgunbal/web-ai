{
  "name": "web-ai",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "pnpm -r --filter=./packages/* test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm --filter @web-ai/core exec tsc -p ../../scripts/tsconfig.json",
    "lint": "pnpm -r lint",
    "demo:guardrail": "pnpm --filter @web-ai/core demo:guardrail",
    "eval:web": "node scripts/run-eval.mjs",
    "evidence:report": "pnpm --filter @web-ai/core exec tsx ../../scripts/evidence-report.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^1.6.1",
    "@types/node": "^22.9.0"
  }
}
